from genetic_algorithm import (
    random_genome, 
    evolve, 
    calculate_fitness, 
    population_size, 
    generations
)
def main():
    print("Training dataset as White Pieces")
    population = [random_genome() for _ in range(population_size)]
    
    for gen in range(generations):
        # Evolve the population
        population = evolve(population)
        
        # pick the best genome of this generation
        best_genome = population[0]
        fitness = calculate_fitness(best_genome)
        
        print(f"Gen {gen + 1} | Best Fitness: {fitness} | "
              f"Weights [P, N, B, R, Q]: {best_genome}")

if __name__ == "__main__":
    main()
